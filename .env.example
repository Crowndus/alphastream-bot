# Deriv OAuth (register at developers.deriv.com)
CLIENT_ID=your_deriv_oauth_client_id
APP_ID=your_deriv_app_id

# Alphastream affiliate tracking (from your Deriv partner referral link)
# e.g. referral link: https://deriv.com/signup?sidc=XXXX&utm_campaign=YYYY
#   AFFILIATE_TOKEN = the sidc value
#   UTM_CAMPAIGN    = the utm_campaign value
AFFILIATE_TOKEN=your_affiliate_token
UTM_CAMPAIGN=your_utm_campaign

APP_ENV=production

# Link back to the separate Alphastream Trader app (shown in the menu)
TRADER_URL=https://alphastream-acvc.vercel.app
